# OTA Watchdog — environment variable reference
# Copy to .env or set in your shell. Never commit real credentials.

# Supplied challenge dataset directory
# Leave blank to use the repository default:
# input/dataset/raw/MoveInSynch Anonymized Trip Log Dataset/
MIS_DATA_DIR=

# AWS authentication (uses boto3 standard credential chain)
AWS_PROFILE=
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Bedrock model — omit entirely to use deterministic fallback narrative
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Demo startup cycle (defaults shown — change only to test different pairs)
OTA_DEMO_PRIOR_PERIOD=May
OTA_DEMO_CURRENT_PERIOD=June
